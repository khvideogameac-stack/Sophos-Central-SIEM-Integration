<!--
  Sophos Central rules for Wazuh.

  Install to /var/ossec/etc/rules/ on the Wazuh manager, then restart
  wazuh-manager. See wazuh/README.md for the full procedure.

  These assume `format = wazuh` in config.ini, which adds the `integration`
  marker every rule below keys on, and copies the client IP into `srcip` so
  Wazuh's GeoIP and <srcip> matching work. With `format = json` the events
  still decode, but rule 100200 will not match and nothing here fires.

  Rule id range 100200-100299 is reserved for this integration. Wazuh reserves
  everything below 100000 for its own ruleset; if 1002xx collides with
  something you already run, renumber the whole block consistently.

  ORDER MATTERS. Every rule here is a child of 100200, and among sibling rules
  Wazuh takes the first one that matches. So the specific type rules come
  first and the generic severity fallback comes last, otherwise a low-severity
  threat detection would match the severity rule and never reach its own.

  Field matching uses osregex, Wazuh's default engine, not PCRE. In osregex
  `\.` means "any character" and a bare `.` is a literal dot - which is why
  the wildcard below is written `\.*` rather than `.*`.

  Levels follow Sophos severity by default:
    none/low -> 3/4, medium -> 7, high -> 10, very_high -> 12
  Type-specific rules override that where the event type is more informative
  than the severity Sophos assigned it.
-->
<group name="sophos,sophos_central,">

  <!-- Base rule. Level 0 so it never alerts on its own; everything below
       chains off it, which keeps the decoded_as test out of every child. -->
  <rule id="100200" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">^sophos-central$</field>
    <description>Sophos Central event (base rule, does not alert)</description>
  </rule>

  <!-- ===============================================================
       Threat detections. Most specific first.
       =============================================================== -->

  <!-- Cleanup failure outranks plain detection: the endpoint is still
       infected and needs someone to touch it. Listed before Detected so it
       wins for events matching both shapes. -->
  <rule id="100212" level="13">
    <if_sid>100200</if_sid>
    <field name="type">Threat::\.*CleanupFailed$|Core\.*CleanFailed$</field>
    <description>Sophos malware CLEANUP FAILED: $(name) [$(location)]</description>
    <group>malware,sophos_threat,</group>
    <mitre>
      <id>T1204</id>
    </mitre>
  </rule>

  <rule id="100214" level="12">
    <if_sid>100200</if_sid>
    <field name="type">Threat::CommandAndControl</field>
    <description>Sophos C2: $(name) [$(location)]</description>
    <group>malware,sophos_threat,</group>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

  <rule id="100210" level="12">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::Threat::Detected$|^Event::Endpoint::CoreDetection$</field>
    <description>Sophos malware: $(name) [$(location)]</description>
    <group>malware,sophos_threat,</group>
    <mitre>
      <id>T1204</id>
    </mitre>
  </rule>

  <!-- Same detection arriving on the alert stream rather than the event
       stream: Sophos is saying this one needs action, so it outranks the
       event. A child of 100210 rather than a sibling, so the malware group
       and MITRE tagging still apply. -->
  <rule id="100216" level="13">
    <if_sid>100210</if_sid>
    <field name="datastream">^alert$</field>
    <description>Sophos malware ALERT: $(name) [$(location)]</description>
    <group>malware,sophos_threat,sophos_alert,</group>
    <mitre>
      <id>T1204</id>
    </mitre>
  </rule>

  <rule id="100213" level="10">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::Threat::PuaDetected$|^Event::Endpoint::CorePuaDetection$</field>
    <description>Sophos PUA: $(name) [$(location)]</description>
    <group>malware,sophos_threat,</group>
  </rule>

  <!-- Someone overrode a block. Worth seeing even though nothing broke. -->
  <rule id="100215" level="9">
    <if_sid>100200</if_sid>
    <field name="type">Threat::HIPSDismissed$</field>
    <description>Sophos HIPS dismissed: $(name) [$(location)]</description>
    <group>sophos_threat,</group>
  </rule>

  <rule id="100211" level="6">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::Threat::CleanedUp$|^Event::Endpoint::CorePuaClean$|^Event::Endpoint::CoreClean$</field>
    <description>Sophos malware cleaned: $(name) [$(location)]</description>
    <group>malware,sophos_threat,</group>
  </rule>

  <!-- A detection dismissed in Sophos Central. Deliberately lower than the
       HIPS equivalent above: in a real tenant these run to dozens a day, and
       at level 9 they drown everything else. Raise it if dismissals are rare
       in your environment, or if you want to review every one. -->
  <rule id="100217" level="5">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::CoreDismissed$</field>
    <description>Sophos detection dismissed: $(name) [$(location)]</description>
    <group>sophos_threat,</group>
  </rule>

  <!-- ===============================================================
       Data loss prevention.
       =============================================================== -->

  <rule id="100220" level="8">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::DataLossPreventionUserAllowed$</field>
    <description>Sophos DLP: $(name) [$(location)]</description>
    <group>sophos_dlp,</group>
    <mitre>
      <id>T1567</id>
    </mitre>
  </rule>

  <!-- ===============================================================
       Policy and hygiene. Low value individually, useful in aggregate.
       =============================================================== -->

  <rule id="100230" level="4">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::WebControlViolation$|^Event::Endpoint::WebFilteringBlocked$</field>
    <description>Sophos web policy: $(name) [$(location)]</description>
    <group>sophos_web,</group>
  </rule>

  <rule id="100231" level="5">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::NonCompliant$</field>
    <description>Sophos compliance: $(name) [$(location)]</description>
    <group>sophos_compliance,</group>
  </rule>

  <rule id="100232" level="5">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::UpdateFailure$</field>
    <description>Sophos update failed: $(name) [$(location)]</description>
    <group>sophos_compliance,</group>
  </rule>

  <!-- Application control did its job. Worth recording, not worth waking
       anyone: the block already happened. -->
  <rule id="100233" level="5">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::Application::Blocked$</field>
    <description>Sophos app blocked: $(name) [$(location)]</description>
    <group>sophos_policy,</group>
  </rule>

  <!-- Endpoint is waiting on a reboot to finish updating. High volume and
       low urgency, but it is the signal that protection is not fully
       current, so it belongs in the compliance group rather than the
       generic severity fallback. -->
  <rule id="100234" level="3">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::UpdateRebootRequired$</field>
    <description>Sophos: $(name) [$(location)]</description>
    <group>sophos_compliance,</group>
  </rule>

  <!-- Routine maintenance: the product working normally. Given its own rule
       rather than left on the severity fallback so it can be grouped and
       suppressed without touching anything else. -->
  <rule id="100235" level="3">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::UpdateSuccess$|^Event::Endpoint::SavScanComplete$</field>
    <description>Sophos: $(name) [$(location)]</description>
    <group>sophos_compliance,</group>
  </rule>

  <!-- Device control blocked a peripheral, typically removable storage.
       The block already happened, so this is not urgent, but it is the
       trace left by an attempt to move data onto or off a machine and it
       should not be buried in the generic fallback. -->
  <rule id="100236" level="5">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::Device::Blocked$</field>
    <description>Sophos device blocked: $(name) [$(location)]</description>
    <group>sophos_device,</group>
    <mitre>
      <id>T1200</id>
    </mitre>
  </rule>

  <!-- Device control in monitor-only mode: the device was NOT blocked, it
       was merely recorded. Worth more attention than a block, not less. -->
  <rule id="100237" level="6">
    <if_sid>100200</if_sid>
    <field name="type">^Event::Endpoint::Device::AlertedOnly$</field>
    <description>Sophos device allowed (alert only): $(name) [$(location)]</description>
    <group>sophos_device,</group>
    <mitre>
      <id>T1200</id>
    </mitre>
  </rule>

  <!-- ===============================================================
       Alerts. The alert stream is Sophos telling you something needs
       action, so it outranks the equivalent event. Note these are the
       catch-all: an alert whose type already matched a specific rule
       above is escalated by a child of that rule instead (see 100216),
       which keeps its group and MITRE tagging.
       =============================================================== -->

  <rule id="100240" level="10">
    <if_sid>100200</if_sid>
    <field name="datastream">^alert$</field>
    <description>Sophos Central alert: $(name) [$(location)]</description>
    <group>sophos_alert,</group>
  </rule>

  <rule id="100241" level="13">
    <if_sid>100240</if_sid>
    <field name="severity">^high$|^very_high$</field>
    <description>Sophos Central HIGH alert: $(name) [$(location)]</description>
    <group>sophos_alert,</group>
  </rule>

  <!-- ===============================================================
       Severity fallback. Anything not matched above still lands at a
       level derived from what Sophos told us. Must stay last.
       =============================================================== -->

  <rule id="100203" level="10">
    <if_sid>100200</if_sid>
    <field name="severity">^high$|^very_high$</field>
    <description>Sophos: $(name) [$(location)]</description>
    <group>sophos_high,</group>
  </rule>

  <rule id="100202" level="7">
    <if_sid>100200</if_sid>
    <field name="severity">^medium$</field>
    <description>Sophos: $(name) [$(location)]</description>
    <group>sophos_medium,</group>
  </rule>

  <rule id="100201" level="3">
    <if_sid>100200</if_sid>
    <field name="severity">^none$|^low$</field>
    <description>Sophos: $(name) [$(location)]</description>
    <group>sophos_low,</group>
  </rule>

  <!-- ===============================================================
       Correlation.
       =============================================================== -->

  <!-- Repeated detections on one endpoint in a short window reads as an
       outbreak or a re-infecting dropper rather than a one-off catch. -->
  <rule id="100290" level="14" frequency="4" timeframe="600">
    <if_matched_sid>100210</if_matched_sid>
    <same_field>location</same_field>
    <description>Sophos OUTBREAK: repeated malware detections on $(location)</description>
    <group>malware,sophos_threat,</group>
  </rule>

  <!-- The same threat name spreading across endpoints is what distinguishes
       a worm from background noise. This is the rule most likely to need
       tuning for your Wazuh version - verify it with wazuh-logtest. -->
  <rule id="100291" level="14" frequency="6" timeframe="900">
    <if_matched_sid>100210</if_matched_sid>
    <same_field>name</same_field>
    <different_field>location</different_field>
    <description>Sophos WORM: $(name) seen on multiple endpoints</description>
    <group>malware,sophos_threat,</group>
  </rule>

  <rule id="100292" level="12" frequency="8" timeframe="300">
    <if_matched_sid>100212</if_matched_sid>
    <same_field>location</same_field>
    <description>Sophos: repeated cleanup failures on $(location), endpoint may be compromised</description>
    <group>malware,sophos_threat,</group>
  </rule>

</group>
