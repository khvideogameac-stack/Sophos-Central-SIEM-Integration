[login]
# API Access URL + Headers
# API token setup steps: https://community.sophos.com/kb/en-us/125169
token_info = <Copy API Access URL + Headers block from Sophos Central here>

# Client ID and Client Secret for Partners, Organizations and Tenants
# Prefer environment variables so secrets do not need to be stored in this file:
#   SOPHOS_CLIENT_ID, SOPHOS_CLIENT_SECRET, SOPHOS_TENANT_ID
client_id =
client_secret =
tenant_id =

# Host URL for OAuth token
auth_url = https://id.sophos.com/api/v2/oauth2/token

# whoami API host URL
api_host = api.central.sophos.com

# Wazuh-safe defaults. The shipped rules require format = wazuh.
format = wazuh

# File output avoids UDP truncation and preserves full_log in Wazuh.
# This value must be a plain filename, not an absolute path or a path containing ..
filename = sophos_central.json

# Rotate before the feed can grow until the disk fills.
max_log_file_size_mb = 100
log_file_backup_count = 5

# Collect both events and alerts.
endpoint = all

# Syslog properties, only used when filename = syslog
address = /var/run/syslog
facility = daemon
socktype = udp
append_nul = false

# Cache file full or relative path (with a .json extension)
state_file_path = state/siem_sophos.json

# Delay collection to avoid late-arriving events being skipped.
events_from_date_offset_minutes = 0
alerts_from_date_offset_minutes = 0

# Convert the dhost field to valid FQDN for CEF/JSON compatibility modes.
convert_dhost_field_to_valid_fqdn = true

# Seconds to wait on a single Sophos API request before retrying it.
request_timeout_seconds = 30

# Collector diagnostics. DEBUG must never print request headers, credentials,
# authorization tokens, request bodies, or full API response payloads.
logging_level = INFO
